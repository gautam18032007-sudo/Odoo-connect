# ===================================================
# ZenZebra Sales CRM — Production Environment Configuration
# Copy this file to .env.local for local development
# Add these variables to your Vercel Project Settings -> Environment Variables
# ===================================================

# 1. Neon PostgreSQL Database (Pooled Connection URL with SSL)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Odoo 19 Enterprise SaaS Credentials
ODOO_URL="https://zenzebra1.odoo.com"
ODOO_DB="zenzebra1"
ODOO_USERNAME="diwakar@zenzebra.in"
ODOO_PASSWORD="your-odoo-password-or-api-key"

# 3. Real-Time Webhook Security Secret
# Match this secret with x-webhook-secret header in Odoo Automated Action
ODOO_WEBHOOK_SECRET="zenzebra_webhook_secret_2026"

# 4. Scheduled Backup Cron Secret
# Used for Vercel Cron authentication (Header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="zenzebra_cron_secret_2026"

# 5. Application Public Domain URL
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# 6. Legacy Cron Backup Sync — DISABLED BY DEFAULT.
# The Oracle-hosted always-on worker is the primary sync engine (see
# docs/WORKER_DEPLOYMENT.md). /api/cron, /api/cron/sync, /api/cron/odoo-sync
# all no-op unless this is explicitly set to "true" — do not enable this
# alongside a running worker, it has no queue/retry/DLQ/locking and would
# race the worker's writes to the same tables.
# LEGACY_CRON_SYNC_ENABLED="false"

# 7. Internal API Secret — authenticates the Oracle worker's calls into
# /api/internal/revalidate (cache invalidation bridge). Same secret must be
# set in .env.worker.example on the worker host.
INTERNAL_API_SECRET="generate-a-long-random-value"
