# ===================================================
# ZenZebra Always-On Sync Worker — Environment Configuration
# For the Oracle Cloud (or any always-on host) worker deployment ONLY.
#
# This is deliberately narrower than .env.example (the Vercel web app's
# env file) — confirmed against src/lib/db.ts, src/lib/odoo/client.ts, and
# src/lib/odoo/sync/worker.ts. It does NOT need ODOO_WEBHOOK_SECRET or
# CRON_SECRET — those are read by the Next.js app's API routes, not by
# this worker. It DOES need NEXT_PUBLIC_APP_URL + INTERNAL_API_SECRET
# (added below) so it can call /api/internal/revalidate after a sync with
# changes — without them, cache invalidation silently skips and the
# dashboard falls back to client polling only (still correct, just slower).
#
# Copy this file to .env.local next to sync-worker.mjs on the VM (that's
# what start-sync-worker.ts's loader reads) — or, for Docker/systemd,
# these same values are injected as real env vars via env_file /
# EnvironmentFile instead (see docker-compose.worker.yml /
# deploy/zenzebra-worker.service).
# ===================================================

# 1. Neon PostgreSQL Database — same pooled connection string as the web app
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Odoo 19 Enterprise SaaS Credentials — same as the web app's .env.example
ODOO_URL="https://zenzebra1.odoo.com"
ODOO_DB="zenzebra1"
ODOO_USERNAME="diwakar@zenzebra.in"
ODOO_PASSWORD="your-odoo-password-or-api-key"

# 3. Cache invalidation bridge — lets the worker trigger a real dashboard
# cache refresh after syncing changes (see /api/internal/revalidate).
# Optional: if unset, the worker just skips this call and the dashboard
# relies on client polling instead — not broken, just less immediate.
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
INTERNAL_API_SECRET="generate-a-long-random-value"  # must match .env.example's value

# Optional: override the heartbeat freshness threshold (seconds) used by
# scripts/check-worker-health.mjs. Defaults to 120 if unset.
# WORKER_HEALTH_FRESHNESS_SECONDS=120
