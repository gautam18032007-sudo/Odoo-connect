{
  "name": "studio-admin",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "biome lint src --diagnostic-level=error",
    "test": "vitest run",
    "format": "biome format --write",
    "check": "npm run build && npm run lint",
    "check:fix": "biome check --write",
    "prepare": "husky",
    "generate:presets": "ts-node -P tsconfig.scripts.json src/scripts/build/generate-theme-presets.ts",
    "migrate:customer-analytics": "ts-node -P tsconfig.scripts.json src/scripts/migrations/migrate-customer-analytics.ts",
    "refresh:mv": "ts-node -P tsconfig.scripts.json src/scripts/sync/refresh-materialized-views.ts",
    "sync:worker": "node sync-worker.mjs",
    "verify": "ts-node -P tsconfig.scripts.json src/scripts/verification/verify-all.ts",
    "verify:regression": "ts-node -P tsconfig.scripts.json src/scripts/verification/verify-regression.ts",
    "verify:customer-intelligence": "ts-node -P tsconfig.scripts.json src/scripts/verification/verify-customer-intelligence.ts",
    "verify:data-platform": "ts-node -P tsconfig.scripts.json src/scripts/verification/verify-data-platform.ts",
    "verify:profitability": "ts-node -P tsconfig.scripts.json src/scripts/verification/verify-profitability.ts",
    "verify:performance": "ts-node -P tsconfig.scripts.json src/scripts/verification/verify-performance.ts",
    "verify:ground-truth": "ts-node -P tsconfig.scripts.json src/scripts/verification/verify-ground-truth.ts",
    "verify:live": "ts-node -P tsconfig.scripts.json src/scripts/verification/verify-live.ts",
    "test:load": "ts-node -P tsconfig.scripts.json src/scripts/verification/load-test.ts"
  },
  "lint-staged": {
    "src/**/*.{js,ts,jsx,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@tanstack/react-table": "^8.21.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.38.0",
    "geist": "^1.7.0",
    "input-otp": "^1.4.2",
    "ioredis": "^5.10.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.11.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.5.0",
    "simple-icons": "^16.18.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.1.5",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
